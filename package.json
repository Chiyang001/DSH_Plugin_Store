{
  "name": "dsh-plugin-store",
  "version": "0.3.5",
  "description": "DeepSeek Harness 中文插件商店：发现、分类、收藏与插件管理",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "examples/index.json",
    "docs"
  ],
  "author": {
    "name": "炽阳001",
    "url": "https://space.bilibili.com/404891612"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "test:discovery-ui": "node scripts/test-discovery-ui.mjs",
    "pack:plugin": "npm run build && npm pack",
    "catalog:refresh": "tsx scripts/refresh-catalog.ts",
    "catalog:collect": "python scripts/expand-community.py && python scripts/enrich-logos.py && tsx scripts/normalize-catalog.ts",
    "test:layout": "node scripts/test-layout-switch.mjs",
    "test:registry-ui": "node scripts/test-registry-ui.mjs",
    "test:poetry-ui": "node scripts/test-poetry-ui.mjs",
    "test:community-ui": "node scripts/test-community-ui.mjs",
    "docs:images": "node scripts/render-doc-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chiyang001/DSH_Plugin_Store.git"
  },
  "homepage": "https://github.com/Chiyang001/DSH_Plugin_Store#readme",
  "bugs": {
    "url": "https://github.com/Chiyang001/DSH_Plugin_Store/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin-store",
    "plugin-manager",
    "community-plugins"
  ]
}
